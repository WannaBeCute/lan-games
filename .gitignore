# ---- 依赖（本项目零依赖，但保险起见） ----
node_modules/

# ---- 编辑器/助手的项目数据（不属于源码） ----
.workbuddy/

# ---- 测试产物（界面自检截图） ----
tools/shots/

# ---- 本机相关的诊断输出 / 快捷信息（每台机器都不一样） ----
_net.txt
网站链接.txt

# ---- 好友系统运行时数据（好友关系与聊天记录，每台服务器各一份） ----
platform/server/friends-data.json

# ---- 底力练习器运行时数据（排行榜 / 皮肤广场，每台服务器各一份） ----
games/dili/server/data/

# ---- 日志 ----
*.log
npm-debug.log*

# ---- 操作系统 ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- 交付产物（压缩包 / git bundle，不属于源码） ----
delivery/
